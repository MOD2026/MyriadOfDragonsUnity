# Unity crash reports and build artifacts
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Test output from the batch EditMode runs (regenerated every run)
results.xml
run.log
*.testresults.xml
# Every ad-hoc named batch-run result/log dropped at repo root (block_*, _mvp_*, full_run.log, etc.)
# 104+ of these accumulated uncommitted before the 2026-08-23 cleanup - regenerate, never commit.
/*.xml
/*.log

# Claude Code local session settings (machine-specific, not shared)
.claude/settings.local.json

# Cross-seat Unity exclusive-access lock (tools/run_editmode_tests.ps1) - machine-local, never commit
.unity_batch.lock

# OS noise
.DS_Store
Thumbs.db
desktop.ini

